# Copy to .env, fill values, then export: set -a; source .env; set +a
# .env is not automatically loaded by Django.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Relative to the project root. Preserves the existing learner database.
DATABASE_PATH=config/db.sqlite3
DJANGO_LOG_LEVEL=INFO
# AI remains unavailable until BOTH values are configured.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=30
# Provider retries may repeat work after an ambiguous timeout. Default is no retries.
OPENAI_MAX_RETRIES=0
AI_FEEDBACK_THROTTLE_RATE=10/hour
# Production: set settings.production, a strong persistent key, real hosts and HTTPS.
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
DJANGO_TRUST_PROXY_SSL_HEADER=false
