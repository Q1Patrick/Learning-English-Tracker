# Public browser configuration: never put passwords, JWTs or API keys in VITE_*.
# Defaults work without copying this file; restart Vite after changing environment.
VITE_API_BASE_URL=/api/v1/
# Web sessions require this same-origin API path. Cross-origin cookie mode is intentionally blocked.
# Backend CSRF trusted origin must match the browser URL; QA launcher accepts --frontend-origin.

# Vite dev/preview server only. Use the Django origin, without /api/v1/.
DEV_API_TARGET=http://127.0.0.1:8000
